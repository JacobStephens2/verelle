[Unit]
Description=Create an encrypted off-host Verelle backup

[Service]
Type=oneshot
User=verelle-backup
Group=verelle-backup
EnvironmentFile=/etc/verelle/backup.env
ExecStart=/opt/verelle/ops/verelle-backup.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/verelle-backup
UMask=0077
