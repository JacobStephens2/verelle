{
  "name": "verelle",
  "private": true,
  "version": "0.1.0",
  "description": "Verelle - a record-and-display chart for couples using the Marquette Method.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && vite build && npm run verify:no-server-url",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:no-server-url": "node scripts/verify-no-server-url.mjs",
    "native:assets": "npm run build && cap sync && npm run verify:no-server-url",
    "smoke:empty-chart": "node scripts/empty-chart-browser-smoke.mjs",
    "smoke:record-observation": "node scripts/record-observation-browser-smoke.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.0",
    "@evolu/common": "^8.7.0",
    "@evolu/web": "^3.1.0",
    "jsqr": "^1.4.0",
    "uqr": "^0.1.3",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "puppeteer-core": "^25.9.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  }
}
