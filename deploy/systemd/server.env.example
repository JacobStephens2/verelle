# Installed as /etc/verelle/server.env with mode 0600. Never commit real values.
DATABASE_URL=postgresql://verelle_app:REPLACE_WITH_URL_SAFE_PASSWORD@127.0.0.1/verelle
VERELLE_BIND_ADDRESS=127.0.0.1:3035
VERELLE_DATABASE_MAX_CONNECTIONS=10
VERELLE_DATABASE_ACQUIRE_TIMEOUT_SECONDS=5
VERELLE_REVIEWED_API_ENABLED=false
VERELLE_OPAQUE_SERVER_SETUP=REPLACE_WITH_BASE64URL_SETUP
# Required only after OQ-9 is signed off and reviewed API is set to true:
# VERELLE_OQ9_REVIEW_REFERENCE=reviewed-commit-and-record
RUST_LOG=verelle_server=info,tower_http=warn
