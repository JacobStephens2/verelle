VERELLE_BIND_ADDRESS={{ verelle_listen }}
DATABASE_URL={{ verelle_database_url }}
VERELLE_OPAQUE_SERVER_SETUP={{ verelle_opaque_server_setup }}
VERELLE_REVIEWED_API_ENABLED={{ verelle_reviewed_api_enabled | default('true') }}
VERELLE_OQ9_REVIEW_REFERENCE={{ verelle_oq9_review_reference | default('docs/reviews/oq9-owner-waiver-2026-07-19.md') }}
VERELLE_BILLING_ENFORCEMENT={{ verelle_billing_enforcement | default('false') }}
RUST_LOG={{ verelle_rust_log | default('verelle_server=info,tower_http=info') }}
{% if stripe_secret_key is defined %}
STRIPE_SECRET_KEY={{ stripe_secret_key }}
STRIPE_WEBHOOK_SECRET={{ stripe_webhook_secret }}
STRIPE_MONTHLY_PRICE_ID={{ stripe_monthly_price_id }}
STRIPE_ANNUAL_PRICE_ID={{ stripe_annual_price_id }}
VERELLE_PUBLIC_ORIGIN=https://verelle.app
{% endif %}
